    {
      "when": {
        "additionalPlugins": [
          "DynamicActorPlugin"
        ]
      },
      "use": "DynamicA"
    },
    {
      "when": {
        "additionalPlugins": [
          "Mico27/SceneStackExPlugin"
        ]
      },
      "use": "Sce"
    },
    {
      "when": {
        "additionalPlugins": [
          "SceneStackExPlugin"
        ]
      },
      "use": "Sce"
    },
    {
      "when": {
        "additionalPlugins": [
          "Mico27/SpritesheetChangeBufferPlugin"
        ]
      },
      "use": "Spr"
    },
    {
      "when": {
        "additionalPlugins": [
          "SpritesheetChangeBufferPlugin"
        ]
      },
      "use": "Spr"
    }
  ]
}