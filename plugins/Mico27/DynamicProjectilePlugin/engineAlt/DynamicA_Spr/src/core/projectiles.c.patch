+
+// Writes a whole behaviour into a projectile slot, the way Define Actor
+// Behavior does for actors. Everything that describes how projectiles from this
+// slot move and react lives in the definition.
+void vm_define_projectile_behavior(SCRIPT_CTX * THIS) OLDCALL BANKED {
+    UBYTE slot = *(UBYTE *)VM_REF_TO_PTR(FN_ARG0);
+    if (slot >= MAX_PROJECTILE_DEFS) return;
+    projectile_def_t *def = projectile_defs + slot;
+    def->type      = *(UBYTE *)VM_REF_TO_PTR(FN_ARG1);
+    def->flags     = *(UBYTE *)VM_REF_TO_PTR(FN_ARG2);
+    def->collision = *(UBYTE *)VM_REF_TO_PTR(FN_ARG3);
+    // Clamped rather than truncated: gravity is only 4 bits, and a value from a
+    // variable (or an older project saved when the range was wider) would
+    // otherwise wrap round into the opposite sign.
+    BYTE gravity = *(BYTE *)VM_REF_TO_PTR(FN_ARG4);
+    if (gravity > DEF_GRAVITY_MAX) gravity = DEF_GRAVITY_MAX;
+    else if (gravity < DEF_GRAVITY_MIN) gravity = DEF_GRAVITY_MIN;
+    def->gravity   = (UBYTE)(gravity + DEF_GRAVITY_BIAS);
+    def->bounce    = *(UBYTE *)VM_REF_TO_PTR(FN_ARG5);
+    def->amplitude = *(BYTE  *)VM_REF_TO_PTR(FN_ARG6);
+    def->frequency = *(UBYTE *)VM_REF_TO_PTR(FN_ARG7);
+    (void)THIS;
+}
