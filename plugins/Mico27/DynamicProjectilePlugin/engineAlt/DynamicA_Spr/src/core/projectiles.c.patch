+// The grid size has to come from a setting rather than from topdown_grid: that
+// lives in topdown.c, which GB Studio does not compile into a project with no
+// top-down scene, so reading it from here would fail to link in a platformer.
+// 0 turns realigning off, for scene types where snapping the player is wrong.
+#ifndef DYNPROJ_HOOKSHOT_PULL_GRID
+#define DYNPROJ_HOOKSHOT_PULL_GRID 8
+#endif
+
+#if DYNPROJ_HOOKSHOT_PULL_GRID == 16
+#define PULL_GRID_MASK   0xFE00u
+#define PULL_GRID_SUBPX  512u
+// A 16px grid sits the player's origin one tile below the block origin, the
+// same offset topdown_init applies when it snaps on scene entry.
+#define PULL_GRID_Y_BIAS 256u
+#else
+#define PULL_GRID_MASK   0xFF00u
+#define PULL_GRID_SUBPX  256u
+#define PULL_GRID_Y_BIAS 0u
+#endif
+
+#if DYNPROJ_HOOKSHOT_PULL_GRID != 0
+// Round one axis onto the NEAREST grid point.
+//
+// Nearest rather than backwards along the pull: a pull stops flush, with its
+// leading edge on the last sub-pixel before the obstacle, and for a box that is
+// a whole number of tiles across that flush position is already a grid point.
+// Rounding away from the obstacle would give up as much as a whole cell and
+// leave the actor standing a tile short of the wall.
+static UWORD hookshot_align_axis(UWORD pos, UWORD bias) {
+    // Below the bias there is no grid point to round to; the first one is the
+    // bias itself. Only reachable at the very top of the map on a 16px grid.
+    if (pos <= bias) return bias;
+    pos -= bias;
+    pos = (pos + (PULL_GRID_SUBPX / 2u)) & PULL_GRID_MASK;
+    return pos + bias;
+}
+#endif
+
+// Put the source actor back on the grid after a pull. `step` is the movement
+// that was being applied when the pull ended, used only to decide which way to
+// retreat if the aligned spot turns out to be unusable; pass 0 for a pull that
+// ended without moving.
+static void hookshot_realign_source(WORD step_x, WORD step_y) {
+#if DYNPROJ_HOOKSHOT_PULL_GRID != 0
+    actor_t *source = HOOKSHOT_SOURCE();
+    upoint16_t next;
+    next.x = hookshot_align_axis(source->pos.x, 0u);
+    next.y = hookshot_align_axis(source->pos.y, PULL_GRID_Y_BIAS);
+
+#ifdef DYNPROJ_HOOKSHOT_PULL_COLLISION
+    // Rounding to nearest can round TOWARDS the obstacle, which is what makes
+    // the stop look flush - but a sprite whose collision box is not a whole
+    // number of tiles could land inside it that way. Check, and if so give the
+    // cell back along whichever axis was moving.
+    if (hookshot_box_blocked(source, &next)) {
+        if (step_x > 0)      next.x -= PULL_GRID_SUBPX;
+        else if (step_x < 0) next.x += PULL_GRID_SUBPX;
+        if (step_y > 0)      next.y -= PULL_GRID_SUBPX;
+        else if (step_y < 0) next.y += PULL_GRID_SUBPX;
+        // Still no good - better off grid than inside a wall, so leave the
+        // actor exactly where the pull stopped it.
+        if (hookshot_box_blocked(source, &next)) return;
+    }
+#else
+    (void)step_x;
+    (void)step_y;
+#endif
+
+    source->pos.x = next.x;
+    source->pos.y = next.y;
+#else
+    (void)step_x;
+    (void)step_y;
+#endif
+}
+
+// Chain links have no motion of their own: each frame they are placed at a
+// fixed fraction along the line from the source actor to the head. Link 1 sits
+// 3/4 of the way to the head, link 2 at 1/2, link 3 at 1/4. Both axes are
+// interpolated so the chain keeps spanning the gap when the source actor or the
+// head moves off the firing axis.
+static void place_hookshot_chain(void) {
+    actor_t *source = HOOKSHOT_SOURCE();
+    UBYTE weight = 4 - (UBYTE)projectile->x;    // x is the link index, 1..3
+    // Signed gap between the two ends. Shifting before multiplying keeps the
+    // product inside 16 bits for any gap at the cost of a fraction of a pixel
+    // (32 sub-pixels make one pixel).
+    WORD dx = (WORD)(head_pos.x - source->pos.x) >> 2;
+    WORD dy = (WORD)(head_pos.y - source->pos.y) >> 2;
+    projectile->pos.x = source->pos.x + (UWORD)(dx * weight);
+    projectile->pos.y = source->pos.y + (UWORD)(dy * weight);
+}
+
+static void handle_hookshot(void) {
+    if (projectile->x != 0) {
+        if (HOOKSHOT_FINISHED()) {
+            remove_projectile();
+        } else {
+            place_hookshot_chain();
+        }
+    } else {
+        head_pos.x = projectile->pos.x;
+        head_pos.y = projectile->pos.y;
+        switch (projectile_hookshot_state) {
+            case HOOKSHOT_FIRING:
+                projectile->pos.x += projectile->delta_pos.x;
+                projectile->pos.y -= projectile->delta_pos.y;
+                break;
+            case HOOKSHOT_RETURNING:
+                projectile->pos.x -= projectile->delta_pos.x;
+                projectile->pos.y += projectile->delta_pos.y;
+                // The hook is back with its source - retire it, otherwise it
+                // would keep flying past and never be removed.
+                if (hookshot_reached_source()) {
+                    projectile_hookshot_state = HOOKSHOT_DONE;
+                    remove_projectile();
+                }
+                break;
+            case HOOKSHOT_PULL_PLAYER: {
+                actor_t *source = HOOKSHOT_SOURCE();
+                // delta_pos.y is positive-for-up in this plugin, so the world
+                // space step down the y axis is its negation.
+                WORD step_x =  (WORD)projectile->delta_pos.x;
+                WORD step_y = -(WORD)projectile->delta_pos.y;
+#ifdef DYNPROJ_HOOKSHOT_PULL_COLLISION
+                if (hookshot_pull_step(source, step_x, step_y)) {
+                    // Reached a wall or a solid actor on the way. Stop here,
+                    // but still put the actor back on the grid - a top-down
+                    // player left between two grid points cannot move at all.
+                    // Rounding back along the pull is what keeps that from
+                    // undoing the stop and pushing it into the obstacle.
+                    projectile_hookshot_state = HOOKSHOT_DONE;
+                    hookshot_realign_source(step_x, step_y);
+                    remove_projectile();
+                    break;
+                }
+#else
+                source->pos.x += projectile->delta_pos.x;
+                source->pos.y -= projectile->delta_pos.y;
+#endif
+                // Arrived at the hook: align the source actor and end the pull.
+                if (hookshot_reached_source()) {
+                    projectile_hookshot_state = HOOKSHOT_REMOVE;
+                    hookshot_realign_source(step_x, step_y);
+                    remove_projectile();
+                }
+                break;
+            }
+            case HOOKSHOT_PULL_ACTOR:
+#ifdef DYNPROJ_HOOKSHOT_PULL_COLLISION
+                // The reeled-in actor leads and the head follows it, rather
+                // than the other way round: if the actor stops short the head
+                // has to stop with it, or it would carry on and drag the chain
+                // straight through whatever the actor is stuck against. The
+                // source actor is solid like any other, so this is also what
+                // keeps a catch from being reeled inside the player.
+                if (hookshot_pull_step(projectile_actor, -(WORD)projectile->delta_pos.x,
+                                                          (WORD)projectile->delta_pos.y)) {
+                    projectile_hookshot_state = HOOKSHOT_DONE;
+                }
+                projectile->pos.x = projectile_actor->pos.x;
+                projectile->pos.y = projectile_actor->pos.y;
+                if (projectile_hookshot_state == HOOKSHOT_DONE) {
+                    remove_projectile();
+                    break;
+                }
+#else
+                projectile->pos.x -= projectile->delta_pos.x;
+                projectile->pos.y += projectile->delta_pos.y;
+                projectile_actor->pos.x = projectile->pos.x;
+                projectile_actor->pos.y = projectile->pos.y;
+#endif
+                if (hookshot_reached_source()) {
+                    projectile_hookshot_state = HOOKSHOT_DONE;
+                    remove_projectile();
+                }
+                break;
+            case HOOKSHOT_STUCK: {
+                // Ride along with whatever the hook grabbed, hanging off the
+                // point of contact rather than the actor's origin.
+                projectile->pos.x =
+                    projectile_actor->pos.x + PX_TO_SUBPX((WORD)HOOKSHOT_STICK_X(projectile));
+                projectile->pos.y =
+                    projectile_actor->pos.y + PX_TO_SUBPX((WORD)HOOKSHOT_STICK_Y(projectile));
+                head_pos.x = projectile->pos.x;
+                head_pos.y = projectile->pos.y;
+                break;
+            }
+            case HOOKSHOT_HELD:
+                // Parked where it landed - the chain still tracks the source.
+                break;
+            case HOOKSHOT_REMOVE:
+                // Driven here by a script rather than by a pull, so there is no
+                // direction to round back along - nearest grid point it is.
+                hookshot_realign_source(0, 0);
+                remove_projectile();
+                break;
+            case HOOKSHOT_DONE:
+                remove_projectile();
+                break;
+        }
+    }
+}
+
+// The hook ran out of room (screen edge): always just come back.
+static void change_hookshot_state(void) {
+    if (projectile_hookshot_state < HOOKSHOT_RETURNING) {
+        projectile_hookshot_state = HOOKSHOT_RETURNING;
+    }
+}
+
+// The hook head touched a solid tile.
+static void hookshot_hit_tile(void) {
+    if (projectile_hookshot_state != HOOKSHOT_FIRING) {
+        return;
+    }
+    switch (projectile_hookshot_tile_hit) {
+        case TILE_HIT_PULL_PLAYER:
+            projectile_hookshot_state = HOOKSHOT_PULL_PLAYER;
+            break;
+        case TILE_HIT_REMOVE:
+            projectile_hookshot_state = HOOKSHOT_DONE;
+            break;
+        case TILE_HIT_STAY:
+            projectile_hookshot_state = HOOKSHOT_HELD;
+            break;
+        default:
+            projectile_hookshot_state = HOOKSHOT_RETURNING;
+            break;
+    }
+    if (projectile_hookshot_state == HOOKSHOT_DONE) {
+        remove_projectile();
+    }
+}
+
+// The hook head touched an actor in its collision mask. Returns TRUE when the
+// hookshot handled the hit itself, FALSE when the caller should fall back to
+// the normal "remove the projectile" behaviour.
+static UBYTE hookshot_hit_actor(actor_t *hit_actor) {
+    if (projectile->x != 0 || projectile_hookshot_state != HOOKSHOT_FIRING) {
+        // A chain link brushed the actor, or the hook already landed. The chain
+        // is only decoration, so leave it alone rather than punching a hole in
+        // the middle of it.
+        return TRUE;
+    }
+
+    UBYTE handled = TRUE;
+    switch (projectile_hookshot_actor_hit) {
+        case ACTOR_HIT_RETURN:
+            projectile_hookshot_state = HOOKSHOT_RETURNING;
+            break;
+        case ACTOR_HIT_PULL_PLAYER:
+            projectile_hookshot_state = HOOKSHOT_PULL_PLAYER;
+            break;
+        case ACTOR_HIT_PULL_ACTOR:
+            // Reel this actor in: handle_hookshot() drags projectile_actor
+            // along with the head while it returns.
+            set_projectile_actor(hit_actor);
+            projectile_hookshot_state = HOOKSHOT_PULL_ACTOR;
+            break;
+        case ACTOR_HIT_STAY:
+            projectile_hookshot_state = HOOKSHOT_HELD;
+            break;
+        case ACTOR_HIT_STICK:
+            // Latch on: the head follows the actor from now on, keeping the
+            // offset it made contact at.
+            set_projectile_actor(hit_actor);
+            HOOKSHOT_STICK_X(projectile) =
+                (BYTE)SUBPX_TO_PX((WORD)(projectile->pos.x - hit_actor->pos.x));
+            HOOKSHOT_STICK_Y(projectile) =
+                (BYTE)SUBPX_TO_PX((WORD)(projectile->pos.y - hit_actor->pos.y));
+            projectile_hookshot_state = HOOKSHOT_STUCK;
+            break;
+        default:
+            // ACTOR_HIT_REMOVE - let the caller destroy the head as usual.
+            handled = FALSE;
+            break;
+    }
+
+    return handled;
+}
+#endif
+
+#ifdef DYNPROJ_ENABLE_ANCHOR
+static void handle_anchor(void) {
+    // Anchor keeps the actor it is pinned to in phase, so several anchored
+    // projectiles can hang off different actors at once - unlike Orbit and the
+    // hookshot, which share the one projectile_actor the last launch resolved.
+    actor_t *anchor_actor = actors + projectile->phase;
+
+    // Rigidly attached: a fixed offset from the actor, the same whichever way
+    // it turns.
+    projectile->pos.x = anchor_actor->pos.x + (projectile->x << 3);
+    projectile->pos.y = anchor_actor->pos.y + (projectile->y << 3);
+}
+#endif
+
+#ifdef DYNPROJ_ENABLE_CHAIN
+// How the links are placed, stored in the definition's `collision` field: a
+// chain never reacts to tiles, so those two bits are free to carry the mode.
+#define CHAIN_STRAIGHT 0
+#define CHAIN_LOOSE    1
+
+// The two ends. Actor indexes rather than pointers, and per projectile rather
+// than shared like Orbit's, so several chains can be strung between different
+// pairs of actors at the same time.
+#define CHAIN_START(p) (actors + (UBYTE)(p)->x)
+#define CHAIN_END(p)   (actors + (UBYTE)(p)->y)
+
+// Slack and catch-up speed for the loose mode, in sub-pixels. Refreshed from
+// the definition at the top of every pass rather than stored per projectile.
+static WORD chain_slack;
+static WORD chain_speed;
+
+// Move one link a step towards its neighbour along a single axis, but only once
+// the gap between them has opened past the slack. That tolerance is the whole
+// trick behind a chain that hangs and drags instead of snapping taut - without
+// it every link tracks its neighbour exactly and the chain is always a straight
+// line. Around 7 pixels of slack against a 2 pixel catch-up reads well.
+static UWORD chain_relax_axis(UWORD link, UWORD towards) {
+    WORD gap = (WORD)(towards - link);
+    WORD excess;
+    if (gap > chain_slack) {
+        excess = gap - chain_slack;
+    } else if (gap < -chain_slack) {
+        excess = gap + chain_slack;     // negative
+    } else {
+        return link;                    // inside the slack - leave it hanging
+    }
+    // Speed 0 means rigid: close the whole excess at once. Otherwise step by at
+    // most the speed, and never past the excess, so the chain settles rather
+    // than jittering back and forth across its neighbour.
+    if (chain_speed) {
+        if (excess > chain_speed) excess = chain_speed;
+        else if (excess < -chain_speed) excess = -chain_speed;
+    }
+    return link + excess;
+}
+
+static void chain_relax(upoint16_t *link, upoint16_t *towards) {
+    link->x = chain_relax_axis(link->x, towards->x);
+    link->y = chain_relax_axis(link->y, towards->y);
+}
+
+// Takes the projectile rather than reading the file-scope one, because
+// projectile_launch() places a new chain straight away and has only its own
+// local pointer to hand.
+//
+// `seed` lays the chain out from nothing, ignoring the loose mode. The loose
+// pass only ever nudges a link TOWARDS its neighbour, so it needs the links to
+// already hold real positions - on a chain's first pass they hold zeros, or
+// whatever the previous owner of the strand left behind, and the whole thing
+// would crawl in from the top-left corner of the map at the catch-up speed.
+static void place_chain(projectile_t *chain, UBYTE seed) {
+    upoint16_t *link = STRAND_POINTS(chain);
+    UBYTE n = strand_length(proj_def);
+    actor_t *start = CHAIN_START(chain);
+    actor_t *end   = CHAIN_END(chain);
+
+    // A chain has no position of its own, so its midpoint stands in for one.
+    // That is what the hit scripts report and what the off-screen test would
+    // use, and it is the one point that is meaningful for both ends at once.
+    chain->pos.x = start->pos.x + ((WORD)(end->pos.x - start->pos.x) >> 1);
+    chain->pos.y = start->pos.y + ((WORD)(end->pos.y - start->pos.y) >> 1);
+
+    if (!seed && proj_def->collision == CHAIN_LOOSE) {
+        chain_slack = PX_TO_SUBPX((WORD)proj_def->amplitude);
+        chain_speed = PX_TO_SUBPX((WORD)proj_def->bounce);
+        // Two passes: the first drags the links along behind the start actor,
+        // the second pulls them back towards the end actor. Running both is
+        // what keeps the chain spanning the gap whichever end moves - one pass
+        // alone leaves the far half trailing behind its anchor.
+        link[0].x = start->pos.x;
+        link[0].y = start->pos.y;
+        for (UBYTE i = 1; i != n; ++i) {
+            chain_relax(&link[i], &link[i - 1]);
+        }
+        link[n - 1].x = end->pos.x;
+        link[n - 1].y = end->pos.y;
+        for (UBYTE i = n - 1; i != 1; --i) {
+            chain_relax(&link[i - 1], &link[i]);
+        }
+    } else {
+        // Straight, and also the shape a loose chain is seeded with: the links
+        // are spread evenly along the line between the two actors, with the
+        // step derived from the link count so any number of links fits.
+        WORD step_x = (WORD)(end->pos.x - start->pos.x) / (n - 1);
+        WORD step_y = (WORD)(end->pos.y - start->pos.y) / (n - 1);
+        UWORD x = start->pos.x;
+        UWORD y = start->pos.y;
+        for (UBYTE i = 0; i != n; ++i) {
+            link[i].x = x;
+            link[i].y = y;
+            x += step_x;
+            y += step_y;
+        }
+        // Both divisions round towards zero, so the last link would otherwise
+        // stop just short of the far actor. Pin it there.
+        link[n - 1].x = end->pos.x;
+        link[n - 1].y = end->pos.y;
+    }
+}
+
+static void handle_chain(void) {
+    // Redefining a slot changes the behaviour of everything already in flight
+    // from it, so a projectile launched as something else can arrive here
+    // without the strand a chain is normally given at launch.
+    if (projectile->phase) place_chain(projectile, FALSE);
+}
+#endif
+
+#ifdef DYNPROJ_ENABLE_TRAIL
+// A trail records where the projectile was on every pass and draws a sprite
+// every `amplitude` entries back through that history, so the tail lags further
+// behind the further down it you look. Storing positions rather than drawing
+// from a formula is what lets the tail follow an arbitrary path - a bouncing or
+// weaving shot drags its tail through the same curve it travelled.
+static void handle_trail(void) {
+    // See handle_chain(): a redefined slot can send a projectile launched as
+    // something else through here with no strand of its own.
+    if (!projectile->phase) return;
+
+    // Strung from an actor: the projectile does not travel under its own power
+    // at all, it simply sits on that actor and records where it has been. Every
+    // other part of the engine - the off-screen test, the hit scripts' idea of
+    // where this happened - then reads the actor's position for free.
+    if (TRAIL_HAS_HEAD(projectile)) {
+        actor_t *head = TRAIL_HEAD(projectile);
+        projectile->pos.x = head->pos.x;
+        projectile->pos.y = head->pos.y;
+    }
+
+    UBYTE strand = STRAND_INDEX(projectile);
+    UBYTE n = strand_length(proj_def);
+    // The cursor walks backwards, which makes entry (head + k) the position k
+    // passes ago - so the segments read forward from the head and this is the
+    // only place the ring has to wrap.
+    UBYTE head = strand_head[strand];
+    head = (head == 0) ? (n - 1) : (head - 1);
+    strand_head[strand] = head;
+    strand_points[strand][head].x = projectile->pos.x;
+    strand_points[strand][head].y = projectile->pos.y;
+}
+#endif
+
+static void handle_types(void) {
+    switch (proj_def->type) {
+#ifdef DYNPROJ_ENABLE_BOOMERANG
+        case BOOMERANG:
+            handle_boomerang();
+            break;
+#endif
+#ifdef DYNPROJ_ENABLE_SINE
+        case SINE:
+            handle_sine();
+            break;
+#endif
+#ifdef DYNPROJ_ENABLE_ORBIT
+        case ORBIT:
+            handle_orbit();
+            break;
+#endif
+#ifdef DYNPROJ_ENABLE_HOOKSHOT
+        case HOOKSHOT:
+            handle_hookshot();
+            break;
+#endif
+#ifdef DYNPROJ_ENABLE_ANCHOR
+        case ANCHOR:
+            handle_anchor();
+            break;
+#endif
+#ifdef DYNPROJ_ENABLE_CUSTOM
+        case CUSTOM:
+            handle_custom();
+            break;
+#endif
+#ifdef DYNPROJ_ENABLE_CHAIN
+        case CHAIN:
+            handle_chain();
+            break;
+#endif
+#ifdef DYNPROJ_ENABLE_TRAIL
+        case TRAIL:
+            handle_trail();
+            break;
+#endif
+        default:
+            break;
+    }
+}
+
+// A projectile in "Remove Projectile" collision mode reached a solid tile.
+static void projectile_hit_tile(void) {
+    // Runs before the projectile is retired, so the script still sees where it
+    // landed and gets in ahead of any removal script.
+    run_tile_hit_script();
+#ifdef DYNPROJ_ENABLE_HOOKSHOT
+    if (proj_def->type == HOOKSHOT) {
+        hookshot_hit_tile();
+        return;
+    }
+#endif
+    remove_projectile();
+}
+
+#ifdef DYNPROJ_USES_STRANDS
+// Actor collision for the behaviours that are a run of sprites rather than one:
+// the whole strand is dangerous, not just the projectile's own position. The
+// first hit wins - there is only one hit to report, and walking the rest of the
+// strand after finding one would cost tile tests for no gain.
+static actor_t *strand_overlapping(actor_t *ignore) {
+    // projectile_launch() refuses to launch a chain or trail without a strand,
+    // so this only guards against a definition whose behaviour was rewritten
+    // out from under projectiles already in flight - phase 0 would index the
+    // pool at -1.
+    if (!projectile->phase) return NULL;
+
+    UBYTE n = strand_length(proj_def);
+    upoint16_t *point = STRAND_POINTS(projectile);
+    UBYTE first = 0, last = n;
+
+#ifdef DYNPROJ_ENABLE_CHAIN
+    if (proj_def->type == CHAIN) {
+        // Skip both end links: they sit exactly on the actors the chain is
+        // strung between, so testing them would report a hit on its own anchors
+        // every single pass.
+        first = 1;
+        last = n - 1;
+    }
+#endif
+#ifdef DYNPROJ_ENABLE_TRAIL
+    if (proj_def->type == TRAIL) {
+        // The head is tested by the caller as usual; here only the drawn
+        // segments matter, so step through the history the way the render does.
+        UBYTE spacing = trail_spacing(proj_def);
+        UBYTE head = strand_head[STRAND_INDEX(projectile)];
+        // The actor a trail is strung from always takes the ignore slot: the
+        // newest segment is only a pass or two behind it, so a stationary head
+        // sits inside its own tail and would answer every test.
+        UBYTE skip_player = FALSE;
+        if (TRAIL_HAS_HEAD(projectile)) {
+            skip_player = (ignore == &PLAYER);
+            ignore = TRAIL_HEAD(projectile);
+        }
+        for (UBYTE i = spacing - 1; i < n; i += spacing) {
+            UBYTE index = head + i;
+            if (index >= n) index -= n;
+            actor_t *hit = actor_overlapping_bb(&proj_def->bounds, &point[index], ignore);
+            // With the head actor holding the ignore slot, "Ignore player
+            // collision" has to be applied by hand for the rest of the tail.
+            if (hit && !(skip_player && hit == &PLAYER)) return hit;
+        }
+        return NULL;
+    }
+#endif
+
+    for (UBYTE i = first; i < last; ++i) {
+        actor_t *hit = actor_overlapping_bb(&proj_def->bounds, &point[i], ignore);
+        if (hit) return hit;
+    }
+    return NULL;
+}
+#endif
+
+static void handle_bounce(void) {
+    if (proj_def->collision == 0) {
+        return;
+    }
+#ifdef DYNPROJ_ENABLE_CHAIN
+    if (proj_def->type == CHAIN) {
+        // A chain is strung between two actors and passes over the scenery
+        // between them, exactly as both reference chains do. `collision` says
+        // how its links are placed instead, so it must not reach the tile tests
+        // below at all.
+        return;
+    }
