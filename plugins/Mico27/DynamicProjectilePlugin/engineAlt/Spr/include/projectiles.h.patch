-extern projectile_def_t projectile_defs[MAX_PROJECTILES];
+// Number of projectile definition slots, from the "Max projectile slots"
+// setting. GB Studio itself only ever fills slots 0-4 (its compiler caps a
+// scene's projectile list at 5 and the stock Load Projectile Slot event offers
+// five buttons), so five is the floor; anything above that is reachable only
+// through this plugin's own slot events.
+#ifndef DYNPROJ_MAX_PROJECTILE_DEFS
+#define DYNPROJ_MAX_PROJECTILE_DEFS 5
+#endif
+#define MAX_PROJECTILE_DEFS DYNPROJ_MAX_PROJECTILE_DEFS
