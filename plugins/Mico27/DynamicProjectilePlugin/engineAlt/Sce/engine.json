    {
      "key": "DYNPROJ_ENABLE_OVERRIDE_TILE_COLLISION",
      "label": "Enable tile collision override",
      "description": "Compile the per-definition 'Tile Collision Override', which replaces the mask a projectile tests against a tile with a fixed value instead of the direction it is travelling, so a slot can react to an extra tile property bit or ignore direction entirely. Unchecked, every tile collision test a projectile makes compiles exactly as it did without the feature and the field is ignored. Tile bits: 1 top, 2 bottom, 4 left, 8 right; then the 16-112 value space (16 ladder, 32-112 the six slopes) and 128, which no engine code reads.",
      "group": "Dynamic Projectiles",
      "type": "checkbox",
      "cType": "define",
      "defaultValue": 0
    },
    {
      "key": "DYNPROJ_ENABLE_TILE_HIT_SCRIPT",
      "label": "Enable script: Tile Hit",
      "group": "Dynamic Projectiles",
      "type": "checkbox",
      "cType": "define",
      "defaultValue": 1
    },
    {
      "key": "DYNPROJ_TILE_HIT_BY_FACE",
      "label": "Tile hit script per face",
      "group": "Dynamic Projectiles",
      "type": "checkbox",
      "cType": "define",
      "defaultValue": 1,
      "indent": 1,
      "conditions": [
        {
          "key": "DYNPROJ_ENABLE_TILE_HIT_SCRIPT",
          "truthy": true
