{
  "type": "enginePlugin",
  "name": "Camera Ex Plugin",
  "author": "Mico27",
  "url": "https://github.com/Mico27/gbs-CameraExPlugin",
  "description": "Extends the stock camera: lock onto any actor (not just the player), lock onto the median position of several actors, smooth (eased) camera transitions when the lock target / offset / deadzone changes, and camera movement along a true direct line instead of only horizontal-first, vertical-first or 45 degree diagonal.",
  "license": "MIT",
  "version": "1.0.0",
  "gbsVersion": ">=4.3.0",
  "order": 10,
  "engineAltRules": [
    {
      "when": {
        "additionalPlugins": [
          "Mico27/ContinuousScenePlugin",
          "Mico27/ScreenScrollPlugin",
          "Mico27/MetaTilePlugin"
        ]
      },
      "use": "Cont_ScreenS_M"
    },
    {
      "when": {
        "additionalPlugins": [
          "ContinuousScenePlugin",
          "ScreenScrollPlugin",
          "MetaTilePlugin"
        ]
      },
      "use": "Cont_ScreenS_M"
    },
    {
      "when": {
        "additionalPlugins": [
          "Mico27/ContinuousScenePlugin",
          "Mico27/MetaTilePlugin"
        ]
      },
      "use": "Cont_M"
    },
    {
      "when": {
        "additionalPlugins": [
          "ContinuousScenePlugin",
          "MetaTilePlugin"
        ]
      },
      "use": "Cont_M"
    },
    {
      "when": {
        "additionalPlugins": [
          "Mico27/ContinuousScenePlugin",
          "Mico27/ScreenScrollPlugin"
        ]
      },
      "use": "Cont_ScreenS"
    },
    {
      "when": {
        "additionalPlugins": [
          "ContinuousScenePlugin",
          "ScreenScrollPlugin"
        ]
      },
      "use": "Cont_ScreenS"
    },
    {
      "when": {
        "additionalPlugins": [
          "Mico27/ScreenScrollPlugin",
          "Mico27/MetaTilePlugin"
        ]
      },
      "use": "ScreenS_M"
    },
    {
      "when": {
        "additionalPlugins": [
          "ScreenScrollPlugin",
          "MetaTilePlugin"
        ]
      },
      "use": "ScreenS_M"
    },
    {
      "when": {
        "additionalPlugins": [
          "Mico27/ContinuousScenePlugin"
        ]
      },
      "use": "Cont"
    },
    {
      "when": {
        "additionalPlugins": [
          "ContinuousScenePlugin"
        ]
      },
      "use": "Cont"
    },
    {
      "when": {
        "additionalPlugins": [
          "Mico27/MetaTilePlugin"
        ]
      },
      "use": "M"
    },
    {
      "when": {
        "additionalPlugins": [
          "MetaTilePlugin"
        ]
      },
      "use": "M"
    },
    {
      "when": {
        "additionalPlugins": [
          "Mico27/ScreenScrollPlugin"
        ]
      },
      "use": "ScreenS"
    },
    {
      "when": {
        "additionalPlugins": [
          "ScreenScrollPlugin"
        ]
      },
      "use": "ScreenS"
    }
  ]
}