{
  "type": "enginePlugin",
  "name": "Screen Transitions Plugin",
  "author": "Mico27",
  "url": "https://github.com/Mico27/gbs-ScreenTransitionsPlugin",
  "description": "A variety of screen transitions (wipes, curtains, iris, diagonal, checkerboard) that run at runtime as waitable VM functions. Supports background/overlay layers, scroll tracking, revealing the current scene, and copying tiles from another scene at a chosen source offset for seamless scene changes.",
  "license": "MIT",
  "version": "1.0.0",
  "gbsVersion": ">=4.3.0",
  "engineAltRules": [
    {
      "when": {
        "additionalPlugins": [
          "Mico27/ContinuousScenePlugin",
          "Mico27/MetaTilePlugin"
        ]
      },
      "use": "Cont_M"
    },
    {
      "when": {
        "additionalPlugins": [
          "ContinuousScenePlugin",
          "MetaTilePlugin"
        ]
      },
      "use": "Cont_M"
    },
    {
      "when": {
        "additionalPlugins": [
          "Mico27/ScreenScrollPlugin",
          "Mico27/MetaTilePlugin"
        ]
      },
      "use": "ScreenS_M"
    },
    {
      "when": {
        "additionalPlugins": [
          "ScreenScrollPlugin",
          "MetaTilePlugin"
        ]
      },
      "use": "ScreenS_M"
    },
    {
      "when": {
        "additionalPlugins": [
          "Mico27/ContinuousScenePlugin"
        ]
      },
      "use": "Cont"
    },
    {
      "when": {
        "additionalPlugins": [
          "ContinuousScenePlugin"
        ]
      },
      "use": "Cont"
    },
    {
      "when": {
        "additionalPlugins": [
          "Mico27/MetaTilePlugin"
        ]
      },
      "use": "M"
    },
    {
      "when": {
        "additionalPlugins": [
          "MetaTilePlugin"
        ]
      },
      "use": "M"
    },
    {
      "when": {
        "additionalPlugins": [
          "Mico27/ScreenScrollPlugin"
        ]
      },
      "use": "ScreenS"
    },
    {
      "when": {
        "additionalPlugins": [
          "ScreenScrollPlugin"
        ]
      },
      "use": "ScreenS"
    }
  ]
}