--- src/core/scroll.c
+++ src/core/scroll.c
@@ -1,26 +1,6 @@
 #pragma bank 255
 
-// Stock scroll.c with one addition: `scroll_render_disabled`.
-//
-// Moving the camera reloads the rows and columns coming into view straight out
-// of the scene's background, which throws away anything the game drew on top of
-// them: a menu, a message box, the battler graphics this plugin composites
-// into the fixed parallax band. With the flag set, the view still moves (the
-// parallax shadow_scx values are still written, so the camera and its layers
-// track normally) but nothing is reloaded, so whatever is in the tile map
-// stays there.
-//
-// Set it with RPG Set Scroll Rendering, and only once everything the camera
-// will travel over is in the map. The map is 32 tiles square, so a scene no
-// larger than that can hold all of itself at once. Scene load clears it.
-//
-// The name matches the flag ScreenScrollPlugin, ContinuousScenePlugin and
-// MetaTilePlugin each invented for the same job in their own copies of this
-// file. Since all four replace scroll.c, installing any of them beside this
-// plugin uses the merged copy in engineAlt/ instead of this one - which is
-// their engine, with whichever part of the flag they were missing added.
-
 #include "scroll.h"
 
 #include <string.h>
 
