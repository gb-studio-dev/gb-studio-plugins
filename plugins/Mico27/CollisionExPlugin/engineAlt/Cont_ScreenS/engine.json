{
  "version": "4.3.0-e1",
  "fields": [
    {
      "key": "COLLISION_EX_ENABLE_PLAYER_XOR",
      "label": "Enable player tile collision mask XOR",
      "description": "Compile the 'Player tile collision mask XOR' field below, which is XOR'd into every tile collision mask the scene type code tests for the player. Unchecked, every one of those tests compiles exactly as stock does - no mask load, no XOR, nothing per frame - and the field is ignored. The extra collision tile swatches this plugin adds to the paint palettes do not depend on this setting.",
      "group": "Collision Ex",
      "type": "checkbox",
      "cType": "define",
      "defaultValue": 1
    },
    {
      "key": "player_xor_tile_collision",
      "label": "Player tile collision mask XOR",
      "description": "Advanced. XOR'd into every collision mask the scene type code tests against a tile for the player, so 0 means stock collision. Tile bits: 1 top, 2 bottom, 4 left, 8 right; then the 16-112 value space (16 ladder, 32-112 the six slopes) and 128, which no engine code reads. A property bit (16 and up) is only ever added to the test, so 16 makes ladder tiles solid. A direction bit is removed from the test that owns it and added to the other three. An empty tile is never solid whatever the value. Change it at runtime with Engine Field Update for temporary effects like a phasing dash or swimming over water tiles.",
      "group": "Collision Ex",
      "type": "number",
      "cType": "UBYTE",
      "min": 0,
      "max": 255,
      "defaultValue": 0,
      "conditions": [
        {
          "key": "COLLISION_EX_ENABLE_PLAYER_XOR",
          "truthy": true
        }
      ]
    },
    {
      "key": "COLLISION_EX_ENABLE_GET_TILE_COLLISION",
      "label": "Enable event: Get tile collision",
      "description": "Compile the 'Get tile collision' event, which reads the raw collision byte of a scene tile into a variable. Uncheck to save ROM if no script uses it.",
      "group": "Collision Ex",
      "type": "checkbox",
      "cType": "define",
      "defaultValue": 1
    },
    {
      "key": "COLLISION_EX_ENABLE_TILE_COLLISION_EVENT",
      "label": "Events: Player tile collision",
      "description": "Compile the four 'Tile ... Collision' slots of 'Attach a Script to a Player Tile Event', fired when a tile stops the player moving that way. Adds one call per blocked player move in every scene type. Uncheck to save ROM if no script listens for it.",
      "group": "Collision Ex",
      "type": "checkbox",
      "cType": "define",
      "defaultValue": 1
    },
    {
      "key": "COLLISION_EX_ENABLE_TILE_ENTER_EVENT",
      "label": "Events: Player tile enter",
      "description": "Compile the 'Tile Enter' slot of 'Attach a Script to a Player Tile Event', fired when the player moves onto a tile it was not on last frame. Adds one check per frame per scene type. Uncheck to save ROM if no script listens for it.",
      "group": "Collision Ex",
      "type": "checkbox",
      "cType": "define",
      "defaultValue": 1
    },
    {
      "key": "COLLISION_EX_TILE_ENTER_DETECTION",
      "label": "Player tile enter detection mode",
      "description": "Origin point fires the enter event for the single tile under the player position - one comparison per frame. Bounding box fires it for every tile the player collision box covers that it did not cover last frame, so a player wider or taller than one tile reports all of them.",
      "group": "Collision Ex",
      "type": "select",
      "cType": "define",
      "defaultValue": "COLLISION_EX_ENTER_ORIGIN_POINT",
      "options": [
        [
          "COLLISION_EX_ENTER_ORIGIN_POINT",
          "Origin point"
        ],
        [
          "COLLISION_EX_ENTER_BOUNDING_BOX",
          "Bounding box"
        ]
      ],
      "conditions": [
        {
          "key": "COLLISION_EX_ENABLE_TILE_ENTER_EVENT",
          "truthy": true
        }
      ]
    },
    {
      "key": "entered_tile_value",
      "label": "Entered tile collision value",
      "description": "Collision byte of the tile the player just entered. Set before the 'Tile Enter' script runs.",
      "group": "Collision Ex",
      "type": "number",
      "cType": "UBYTE",
      "defaultValue": 0,
      "runtimeOnly": true
    },
    {
      "key": "entered_tile_x",
      "label": "Entered tile X",
      "description": "Tile X coordinate the player just entered.",
      "group": "Collision Ex",
      "type": "number",
      "cType": "UBYTE",
      "defaultValue": 0,
      "runtimeOnly": true
    },
    {
      "key": "entered_tile_y",
      "label": "Entered tile Y",
      "description": "Tile Y coordinate the player just entered.",
      "group": "Collision Ex",
      "type": "number",
      "cType": "UBYTE",
      "defaultValue": 0,
      "runtimeOnly": true
    },
    {
      "key": "collided_tile_value",
      "label": "Collided tile collision value",
      "description": "Collision byte of the tile that stopped the player. Set before the 'Tile ... Collision' script runs.",
      "group": "Collision Ex",
      "type": "number",
      "cType": "UBYTE",
      "defaultValue": 0,
      "runtimeOnly": true
    },
    {
      "key": "collided_tile_x",
      "label": "Collided tile X",
      "description": "Tile X coordinate of the tile that stopped the player.",
      "group": "Collision Ex",
      "type": "number",
      "cType": "UBYTE",
      "defaultValue": 0,
      "runtimeOnly": true
    },
    {
      "key": "collided_tile_y",
      "label": "Collided tile Y",
      "description": "Tile Y coordinate of the tile that stopped the player.",
      "group": "Collision Ex",
      "type": "number",
      "cType": "UBYTE",
      "defaultValue": 0,
      "runtimeOnly": true
    },
    {
      "key": "collided_tile_dir",
      "label": "Collided tile direction",
      "description": "Direction the player was travelling when it was stopped: 1 down, 2 right, 3 up, 4 left. Matches the slot that fired.",
      "group": "Collision Ex",
      "type": "number",
      "cType": "UBYTE",
      "defaultValue": 0,
      "runtimeOnly": true
    }
  ],
