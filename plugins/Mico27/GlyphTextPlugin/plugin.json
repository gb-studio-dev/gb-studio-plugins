{
  "type": "enginePlugin",
  "name": "Glyph Text Plugin",
  "author": "Mico27",
  "images": [
    "screenshots/chinese_example.gif",
    "screenshots/japanese_example.gif",
    "screenshots/korean_example.gif",
    "screenshots/multilanguage_example.gif"
  ],
  "version": "4.3.8",
  "gbsVersion": ">=4.3.0",
  "description": "Draws text in full 16 by 16 squares, loading each character as it is printed. Built for writing systems that need large character sets and full-square characters, such as Chinese, Japanese and Korean.",
  "url": "https://github.com/Mico27/gbs-GlyphTextPlugin",
  "mutuallyExclusive": [
    "HalfWidthTextPlugin",
    "TallTextPlugin"
  ],
  "engineAltRules": [
    {
      "when": {
        "additionalPlugins": [
          "Mico27/ContinuousScenePlugin"
        ]
      },
      "use": "Cont"
    },
    {
      "when": {
        "additionalPlugins": [
          "ContinuousScenePlugin"
        ]
      },
      "use": "Cont"
    },
    {
      "when": {
        "additionalPlugins": [
          "Mico27/ScreenScrollPlugin"
        ]
      },
      "use": "ScreenS"
    },
    {
      "when": {
        "additionalPlugins": [
          "ScreenScrollPlugin"
        ]
      },
      "use": "ScreenS"
    }
  ]
}