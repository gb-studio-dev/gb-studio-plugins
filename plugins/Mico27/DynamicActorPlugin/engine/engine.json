{
    "version": "4.3.0-e1",
    "fields": [
        {
          "key": "DYNAMIC_ACTOR_ENABLE_COLLISION_SINGLE_POINT",
          "label": "Collision model: Origin point",
          "description": "Compile the single-point collision model.",
          "group": "Dynamic actor",
          "type": "checkbox",
          "cType": "define",
          "defaultValue": 1
        },
        {
          "key": "DYNAMIC_ACTOR_ENABLE_COLLISION_TRIANGLE",
          "label": "Collision model: Triangle",
          "description": "Compile the triangle collision model.",
          "group": "Dynamic actor",
          "type": "checkbox",
          "cType": "define",
          "defaultValue": 1
        },
        {
          "key": "DYNAMIC_ACTOR_ENABLE_COLLISION_BOUNDING_BOX",
          "label": "Collision model: Bounding box",
          "description": "Compile the bounding-box collision model.",
          "group": "Dynamic actor",
          "type": "checkbox",
          "cType": "define",
          "defaultValue": 1
        },
        {
          "key": "DYNAMIC_ACTOR_ENABLE_SLOPE_COLLISION",
          "label": "Enable slope collision",
          "description": "Enable slope collision",
          "group": "Dynamic actor",
          "type": "checkbox",
          "cType": "define",
          "defaultValue": 0
        },
        {
          "key": "DYNAMIC_ACTOR_ENABLE_OVERRIDE_TILE_COLLISION",
          "label": "Enable tile collision override",
          "description": "Compile the per-behavior 'Tile collision override' of Define Actor Behavior, which replaces the mask a behavior tests against a tile with a fixed value instead of the direction it is moving. Unchecked, every tile collision test in the plugin compiles exactly as it did without the feature - no mask load, no override, nothing per actor per frame - and the field is ignored. The player's own equivalent lives in CollisionExPlugin.",
          "group": "Dynamic actor",
          "type": "checkbox",
          "cType": "define",
          "defaultValue": 0
        },
        {
          "key": "DYNAMIC_ACTOR_MAX_ACTORS",
          "label": "Max actors",
          "description": "Size of the engine's actors[] array, player included. Stock is 21 = the player plus the 20 actors the editor allows in a scene, so 21 is the useful maximum. Lowering it frees a whole actor slot of RAM each (60-71 bytes depending on the components enabled) plus one byte per actor of plugin side tables; a scene holding more actors than this simply loads the first ones and drops the rest.",
          "group": "Dynamic actor",
          "type": "slider",
          "cType": "define",
          "min": 1,
          "max": 21,
          "defaultValue": 21
        },
        {
          "key": "DYNAMIC_ACTOR_MAX_BEHAVIORS",
          "label": "Max behavior slots",
          "description": "Number of behavior definition slots available (each slot uses 8 bytes of RAM). Capped at 15 because each actor stores its behavior id in 4 bits of a byte it shares with its behavior state.",
          "group": "Dynamic actor",
          "type": "slider",
          "cType": "define",
          "min": 1,
          "max": 15,
          "defaultValue": 8
        },
        {
          "key": "DYNAMIC_ACTOR_MAX_PLATFORMS",
          "label": "Max moving platforms",
          "description": "Number of 'Moving platform' actors that can claim/release riders per scene (each uses 11 bytes of RAM). Platforms beyond this limit still move but never pick up riders. Requires the parent actors component.",
          "group": "Dynamic actor",
          "type": "slider",
          "cType": "define",
          "min": 1,
          "max": 8,
          "defaultValue": 2
        },
        {
          "key": "DYNAMIC_ACTOR_ENABLE_GRAVITY",
          "label": "Component: Gravity",
          "description": "Compile the gravity component. Uncheck to save ROM if no behavior uses gravity.",
          "group": "Dynamic actor",
          "type": "checkbox",
          "cType": "define",
          "defaultValue": 1
        },
        {
          "key": "DYNAMIC_ACTOR_ENABLE_MOVE_Z",
          "label": "Topdown Z axis",
          "description": "Enable actor Z position/velocity fields and apply gravity to Z instead of Y (topdown jump/height simulation).",
          "group": "Dynamic actor",
          "type": "checkbox",
          "cType": "define",
          "defaultValue": 0
        },
        {
          "key": "DYNAMIC_ACTOR_ENABLE_MOVE_X",
          "label": "Component: Move horizontally",
          "description": "Compile horizontal movement and wall collision. Uncheck to save ROM if no behavior moves horizontally.",
          "group": "Dynamic actor",
          "type": "checkbox",
          "cType": "define",
          "defaultValue": 1
        },
        {
          "key": "DYNAMIC_ACTOR_ENABLE_MOVE_Y",
          "label": "Component: Move vertically",
          "description": "Compile vertical movement and floor/ceiling collision. Required for gravity to have a visible effect.",
          "group": "Dynamic actor",
          "type": "checkbox",
          "cType": "define",
          "defaultValue": 1
        },
        {
          "key": "DYNAMIC_ACTOR_ENABLE_LEDGE_STOP",
          "label": "Component: Turn at ledges",
          "description": "Compile smart ledge detection. Requires 'Move horizontally'.",
          "group": "Dynamic actor",
          "type": "checkbox",
          "cType": "define",
          "defaultValue": 1
        },
        {
          "key": "DYNAMIC_ACTOR_ENABLE_REFLECT_X",
          "label": "Component: Turn at walls",
          "description": "Compile velocity reversal on wall hits. When disabled, actors stop at walls instead.",
          "group": "Dynamic actor",
          "type": "checkbox",
          "cType": "define",
          "defaultValue": 1
        },
        {
          "key": "DYNAMIC_ACTOR_ENABLE_BOUNCE",
          "label": "Component: Bounce on floor/ceiling",
          "description": "Compile bounce physics (includes 32-bit math). When disabled, actors stop on floor/ceiling instead. Requires 'Move vertically'.",
          "group": "Dynamic actor",
          "type": "checkbox",
          "cType": "define",
          "defaultValue": 1
        },
        {
          "key": "DYNAMIC_ACTOR_ENABLE_PARENT",
          "label": "Component: Parent actors / moving platforms",
          "description": "Compile parent actor inheritance: any actor with a parent set follows the parent's per-frame movement and still runs its own behavior physics. Also compiles the 'Moving platform' behavior component, which automatically parents/unparents the actors it touches. Uncheck to save ROM if nothing uses parenting or platforms.",
          "group": "Dynamic actor",
          "type": "checkbox",
          "cType": "define",
          "defaultValue": 1
        },
        {
          "key": "DYNAMIC_ACTOR_PARENT_MODE",
          "label": "Parenting mode",
          "description": "How a parented actor follows its parent. Static: the actor is pinned at a fixed pixel offset (its own X/Y velocity) from the parent and runs no other behavior code - fastest. Inherit first parent velocity: the actor is carried by its direct parent's velocity (tile-collision checked) and still runs its own behavior - only tracks parents that have a dynamic velocity. Apply all parents positions delta: the actor is displaced by the summed position change of its whole parent chain (tile-collision checked) and still runs its own behavior - follows any parent including engine-moved ones like the player, slowest.",
          "group": "Dynamic actor",
          "type": "select",
          "options": [
            ["0", "Static parenting (Fast)"],
            ["1", "Inherit first parent velocity (Slower)"],
            ["2", "Apply all parents positions delta (Slowest)"]
          ],
          "cType": "define",
          "defaultValue": "2",
          "conditions": [
            {
              "key": "DYNAMIC_ACTOR_ENABLE_PARENT",
              "truthy": true
            }
          ]
        },
        {
          "key": "DYNAMIC_ACTOR_PLATFORM_PLAYER_ONLY",
          "label": "Platforms attach the player only",
          "description": "When checked, a 'Moving platform' actor only auto-attaches the player when it touches it - other actors are ignored (they can still be parented explicitly with Set Actor Parent Actor). When unchecked, a platform attaches every actor it touches (subject to its collision group). Checking this also saves the per-frame claim test on every non-player actor.",
          "group": "Dynamic actor",
          "type": "checkbox",
          "cType": "define",
          "defaultValue": 0,
          "conditions": [
            {
              "key": "DYNAMIC_ACTOR_ENABLE_PARENT",
              "truthy": true
            }
          ]
        },
        {
          "key": "DYNAMIC_ACTOR_ENABLE_ACTOR_COLLISION",
          "label": "Component: Collide with other actors",
          "description": "Compile actor-vs-actor collision (blocks/turns on contact with other collidable actors; the player is already handled by the engine). Uncheck to save ROM if no behavior uses it.",
          "group": "Dynamic actor",
          "type": "checkbox",
          "cType": "define",
          "defaultValue": 1
        },
        {
          "key": "DYNAMIC_ACTOR_ENABLE_HIT_ACTORS",
          "label": "Component: Trigger other actors' On Hit",
          "description": "Compile the 'trigger other actors On Hit on collision' behavior option: an actor with it set runs the On Hit script of every collidable actor it overlaps (the engine normally does this only for the player). Uncheck to save ROM if no behavior uses it.",
          "group": "Dynamic actor",
          "type": "checkbox",
          "cType": "define",
          "defaultValue": 1
        },
        {
          "key": "DYNAMIC_ACTOR_ENABLE_ACTOR_TRIGGERS",
          "label": "Component: Actors activate triggers",
          "description": "Compile the 'activate triggers on enter/leave' behavior option: an actor with it set fires trigger On Enter / On Leave scripts as it moves in and out of triggers (the engine normally does this only for the player). Uses one byte of RAM per actor to track each actor's current trigger. Uncheck to save ROM/RAM if no behavior uses it.",
          "group": "Dynamic actor",
          "type": "checkbox",
          "cType": "define",
          "defaultValue": 1
        },
        {
          "key": "DYNAMIC_ACTOR_ENABLE_ANIMATION",
          "label": "Component: Animation handling",
          "description": "Compile automatic animation (face direction, idle, jump). Uncheck if you handle animations yourself.",
          "group": "Dynamic actor",
          "type": "checkbox",
          "cType": "define",
          "defaultValue": 1
        },
        {
          "key": "DYNAMIC_ACTOR_ENABLE_STATE_CHANGE_EVENT",
          "label": "Events: Actor state changed",
          "description": "Compile the 'Actor state changed' event slot of 'Attach a Script to a Dynamic Actor Event', fired when a behavior moves an actor between paused/grounded/airborne. Uncheck to save ROM if no script listens for it.",
          "group": "Dynamic actor",
          "type": "checkbox",
          "cType": "define",
          "defaultValue": 1
        },
        {
          "key": "DYNAMIC_ACTOR_ENABLE_TILE_COLLISION_EVENTS",
          "label": "Events: Tile collision",
          "description": "Compile the four 'Tile collision' event slots (top / right / bottom / left) of 'Attach a Script to a Dynamic Actor Event'. Unchecking removes the callback dispatch from every collision site in the physics loop and drops 4 callback slots (5 bytes of RAM each).",
          "group": "Dynamic actor",
          "type": "checkbox",
          "cType": "define",
          "defaultValue": 1
        },
        {
          "key": "DYNAMIC_ACTOR_ENABLE_TILE_ENTER_EVENT",
          "label": "Events: Tile enter",
          "description": "Compile the 'Tile enter' event slot of 'Attach a Script to a Dynamic Actor Event', fired when an actor crosses into a new cell of the tile enter grid. Unchecking drops the per-actor start-cell tracking from the physics loop and one callback slot (5 bytes of RAM).",
          "group": "Dynamic actor",
          "type": "checkbox",
          "cType": "define",
          "defaultValue": 1
        },
        {
          "key": "DYNAMIC_ACTOR_TILE_ENTER_SIZE",
          "label": "Tile enter grid",
          "description": "Granularity the 'Tile enter' event fires on. 8x8 fires on every tile the actor crosses; 16x16 fires once per metatile, which is what a 16px-grid game usually wants. The script still receives the real 8x8 tile the actor arrived on either way.",
          "group": "Dynamic actor",
          "type": "select",
          "options": [
            [0, "8x8 tiles"],
            [1, "16x16 tiles"]
          ],
          "cType": "define",
          "defaultValue": 0,
          "indent": 1,
          "conditions": [
            {
              "key": "DYNAMIC_ACTOR_ENABLE_TILE_ENTER_EVENT",
              "truthy": true
            }
          ]
        },
        {
          "key": "DYNAMIC_ACTOR_ENABLE_ACTIVATION_EVENTS",
          "label": "Events: Actor activated / deactivated",
          "description": "Compile the 'Actor activated' and 'Actor deactivated' event slots of 'Attach a Script to a Dynamic Actor Event'. The scripts are launched by the engine when an actor becomes active or is deactivated, including when it scrolls offscreen. Adds two script slots, 5 bytes of memory each. Unticking it leaves the hooks out of the build entirely.",
          "group": "Dynamic actor",
          "type": "checkbox",
          "cType": "define",
          "defaultValue": 1
        },
        {
          "key": "DYNAMIC_ACTOR_ENABLE_ACTOR_ITERATION",
          "label": "Tools: Iterate actors in area",
          "description": "Compile the 'Actor Iterate In Area' event. Uncheck to save ROM if unused.",
          "group": "Dynamic actor",
          "type": "checkbox",
          "cType": "define",
          "defaultValue": 1
        },
        {
          "key": "DYNAMIC_ACTOR_ENABLE_ACTOR_PROPERTIES",
          "label": "Tools: Get / Set extended actor properties",
          "description": "Compile the 'Actor Get Property (Extended)' and 'Actor Set Property (Extended)' events, which reach actor fields no stock event exposes (collision group, flags, animation range, bounds, script handles...). Uncheck to save ROM if unused.",
          "group": "Dynamic actor",
          "type": "checkbox",
          "cType": "define",
          "defaultValue": 1
        },
        {
          "key": "DYNAMIC_ACTOR_ENABLE_TRIGGER_SCRIPT",
          "label": "Tools: Force trigger actor script",
          "description": "Compile the 'Actor Trigger Script' event, which forces an actor's On Interact / On Hit / On Update script to run. Uncheck to save ROM if unused.",
          "group": "Dynamic actor",
          "type": "checkbox",
          "cType": "define",
          "defaultValue": 1
        },
        {
          "key": "DYNAMIC_ACTOR_ENABLE_VM_GET_ACTOR_COLLISION",
          "label": "Tools: Get actor at point",
          "description": "Compile the 'Get Actor Collision' event, which returns the index of the collidable actor overlapping a pixel position (-1 when none). Uncheck to save ROM if unused.",
          "group": "Dynamic actor",
          "type": "checkbox",
          "cType": "define",
          "defaultValue": 1
        },
        {
          "key": "DYNAMIC_ACTOR_ENABLE_VM_WAIT_FOR_COLLISION",
          "label": "VM: Wait for collision",
          "description": "Builds the 'Wait For Actor Collision' events. Untick it to save ROM when no script uses them.",
          "group": "Dynamic actor",
          "type": "checkbox",
          "cType": "define",
          "defaultValue": 1
        },
        {
          "key": "DYNAMIC_ACTOR_ENABLE_VM_WAIT_FOR_IN_RANGE",
          "label": "VM: Wait for actor in range",
          "description": "Builds the 'Wait For Actor In Range' events. Untick it to save ROM when no script uses them.",
          "group": "Dynamic actor",
          "type": "checkbox",
          "cType": "define",
          "defaultValue": 1
        },
        {
          "key": "DYNAMIC_ACTOR_ENABLE_VM_WAIT_FOR_STATE",
          "label": "VM: Wait for actor state",
          "description": "Builds the 'Wait For Actor State' events. Untick it to save ROM when no script uses them.",
          "group": "Dynamic actor",
          "type": "checkbox",
          "cType": "define",
          "defaultValue": 1
        },
        {
          "key": "DYNAMIC_ACTOR_ENABLE_VM_MOTION_CHASE_ACTOR",
          "label": "VM motion: Chase actor",
          "description": "Builds the 'Actor Chase Actor' events. Untick it to save ROM when no script uses them.",
          "group": "Dynamic actor",
          "type": "checkbox",
          "cType": "define",
          "defaultValue": 1
        },
        {
          "key": "DYNAMIC_ACTOR_ENABLE_VM_MOTION_MOVE_TO_POS_BY_VELOCITY",
          "label": "VM motion: Move to position by velocity",
          "description": "Builds the 'Actor Move To Position By Velocity' events. Untick it to save ROM when no script uses them.",
          "group": "Dynamic actor",
          "type": "checkbox",
          "cType": "define",
          "defaultValue": 1
        },
        {
          "key": "DYNAMIC_ACTOR_ENABLE_VM_MOTION_CRAWL_STEP",
          "label": "VM motion: Crawl step",
          "description": "Builds the 'Actor Motion: Wall Crawl' events. Untick it to save ROM when no script uses them.",
          "group": "Dynamic actor",
          "type": "checkbox",
          "cType": "define",
          "defaultValue": 1
        },
        {
          "key": "dynamic_actor_event_actor_idx",
          "label": "Event actor index",
          "description": "Actor index for the current dynamic actor event.",
          "group": "Dynamic actor",
          "type": "number",
          "cType": "UBYTE",
          "defaultValue": 0,
          "runtimeOnly": true
        },
        {
          "key": "dynamic_actor_event_behavior_idx",
          "label": "Event behavior index",
          "description": "Behavior index for the current dynamic actor event.",
          "group": "Dynamic actor",
          "type": "number",
          "cType": "UBYTE",
          "defaultValue": 0,
          "runtimeOnly": true
        },
        {
          "key": "dynamic_actor_event_state",
          "label": "Event state",
          "description": "State for the current dynamic actor event.",
          "group": "Dynamic actor",
          "type": "number",
          "cType": "UBYTE",
          "defaultValue": 0,
          "runtimeOnly": true
        },
        {
          "key": "dynamic_actor_event_tile_idx",
          "label": "Event tile collision",
          "description": "Tile collision value for the current dynamic actor event.",
          "group": "Dynamic actor",
          "type": "number",
          "cType": "UBYTE",
          "defaultValue": 0,
          "runtimeOnly": true
        },
        {
          "key": "dynamic_actor_event_tile_x",
          "label": "Event tile x",
          "description": "Tile x coordinate for the current dynamic actor event.",
          "group": "Dynamic actor",
          "type": "number",
          "cType": "UBYTE",
          "defaultValue": 0,
          "runtimeOnly": true
        },
        {
          "key": "dynamic_actor_event_tile_y",
          "label": "Event tile y",
          "description": "Tile y coordinate for the current dynamic actor event.",
          "group": "Dynamic actor",
          "type": "number",
          "cType": "UBYTE",
          "defaultValue": 0,
          "runtimeOnly": true
        }
    ],
